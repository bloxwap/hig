{
  "version": "0.1.0",
  "issue": "bloxwap/hig#96",
  "evidence": "automated (local tarballs, clean temporary npm workspaces); no publication",
  "platform": "linux x64",
  "node": "v22.22.0",
  "host": {
    "shape": "npm workspace like bloxwap/chart: packages/chart provides @bloxwap/chart, apps/docs depends on it by version and on HIG tarballs through file: specs",
    "chart": "@bloxwap/chart 0.3.0 (published build copied into packages/chart)",
    "install": "rm package-lock.json + node_modules; npm install with legacy-peer-deps=false, strict-peer-deps=true; then npm ci; then npm install (no lockfile change)"
  },
  "runs": [
    {
      "npm": "10.9.4",
      "source": "ambient",
      "scenarios": [
        {
          "name": "react-only",
          "app": [
            "@bloxwap/hig-react",
            "@bloxwap/hig-tokens",
            "@bloxwap/hig-contracts"
          ],
          "freshLockfile": {
            "workspaceInLock": true,
            "link": {
              "resolved": "packages/chart",
              "link": true
            },
            "lockCopies": [
              "node_modules/@bloxwap/chart"
            ],
            "nodeModulesLink": true
          },
          "npmCi": "workspace link kept",
          "reinstall": "lockfile byte-identical",
          "resolved": [
            "packages/chart/dist/index.js",
            "packages/chart/dist/react/index.js"
          ]
        },
        {
          "name": "react-and-chart",
          "app": [
            "@bloxwap/hig-react",
            "@bloxwap/hig-tokens",
            "@bloxwap/hig-contracts",
            "@bloxwap/hig-chart"
          ],
          "freshLockfile": {
            "workspaceInLock": true,
            "link": {
              "resolved": "packages/chart",
              "link": true
            },
            "lockCopies": [
              "node_modules/@bloxwap/chart"
            ],
            "nodeModulesLink": true
          },
          "npmCi": "workspace link kept",
          "reinstall": "lockfile byte-identical",
          "resolved": [
            "packages/chart/dist/index.js",
            "packages/chart/dist/react/index.js"
          ],
          "ssr": "PriceChart summary and host-localized fallback",
          "bundleLazyImport": "packages/chart/dist/react/index.js"
        }
      ],
      "control": {
        "name": "legacy-control",
        "hig": "hig-react repacked with the pre-#96 optional @bloxwap/chart peer",
        "workspaceDropped": true,
        "workspaceInLock": false,
        "link": null,
        "lockCopies": [],
        "nodeModulesLink": false
      }
    },
    {
