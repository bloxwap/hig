{
  "name": "bloxwap-hig-workspace",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "packageManager": "npm@11.6.1",
  "workspaces": [
    "packages/*",
    "fixtures/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "generate": "node scripts/generate.mjs && node scripts/generate-native-fonts-index.mjs && node scripts/generate-brand.mjs",
    "build": "npm run generate && node scripts/build.mjs && npm run build:docs",
    "build:tsc": "npm run generate && node scripts/build.mjs --tsc && node scripts/build-docs.mjs --tsc",
    "typecheck": "tsrs --noEmit && npm run check -w hig-docs",
    "typecheck:tsc": "node node_modules/typescript-7/bin/tsc --noEmit && npm run check:tsc -w hig-docs",
    "lint": "eslint . && node scripts/check-drift.mjs && node scripts/check-built-in-strings.mjs",
    "test": "npm run test:web && npm run test:native",
    "check": "npm run build && npm run lint && npm run typecheck && npm test",
    "dev": "vite fixtures/web --host 0.0.0.0",
    "smoke:ssr": "node fixtures/ssr/smoke.mjs",
    "smoke:packed": "node scripts/packed-smoke.mjs",
    "test:web": "vitest run",
    "test:native": "jest --config jest.native.config.cjs",
    "smoke:packed-native": "node scripts/packed-native-smoke.mjs",
    "smoke:packed-og": "node scripts/packed-og-smoke.mjs",
    "generate:cues": "node scripts/export-cues.mjs",
    "generate:examples": "node scripts/generate-examples.mjs",
    "build:docs": "node scripts/build-docs.mjs",
    "dev:docs": "npm run docs:dev",
    "docs:prepare": "npm run generate && node scripts/build.mjs && npm run generate:examples && node scripts/generate-docs.mjs",
    "docs:dev": "turbo run dev --filter=hig-docs",
    "docs:build": "npm run generate && node scripts/build.mjs && npm run build:docs",
    "docs:check": "npm run docs:prepare && npm run check -w hig-docs",
    "docs:check:tsc": "npm run generate && node scripts/build.mjs --tsc && npm run generate:examples && node scripts/generate-docs.mjs && npm run check:tsc -w hig-docs",
    "docs:preview": "node scripts/preview-docs.mjs",
    "examples:check": "node scripts/check-examples.mjs",
    "build:next": "npm run build -w hig-next-fixture",
    "quality": "node scripts/quality.mjs && node scripts/drift.mjs",
    "smoke:packed-next": "node scripts/packed-next-smoke.mjs",
    "smoke:packed-css": "node scripts/packed-css-smoke.mjs",
    "smoke:packed-react-css": "node scripts/packed-react-css-smoke.mjs",
    "release:dry-run": "node scripts/release-dry-run.mjs",
    "smoke:packed-examples": "node scripts/packed-examples-smoke.mjs",
    "smoke:packed-boundaries": "node scripts/packed-boundaries-smoke.mjs",
    "smoke:packed-chart-workspace": "node scripts/packed-chart-workspace-smoke.mjs",
    "smoke:packed-fumadocs": "node scripts/packed-fumadocs-smoke.mjs",
    "smoke:release-artifact": "node scripts/release-artifact-smoke.mjs",
    "generate:fonts": "python3 scripts/generate-native-fonts.py",
    "generate:glossary": "node scripts/generate-glossary.mjs",
    "smoke:packed-og-fonts": "npm run smoke:packed-og",
    "release:verify": "node scripts/verify-release.mjs",
    "smoke:registry": "node scripts/registry-smoke.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@bloxwap/chart": "0.3.0",
    "@bloxwap/font": "0.1.2",
    "@bloxwap/haptic": "^0.3.0",
    "@bloxwap/sfx": "^0.2.1",
    "@eslint/js": "9.39.5",
    "@gorhom/bottom-sheet": "5.2.14",
    "@playwright/test": "^1.64.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/react-native": "13.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/react-test-renderer": "19.3.0",
    "babel-preset-expo": "54.0.12",
    "esbuild": "^0.25.12",
    "eslint": "9.39.5",
    "expo-audio": "~1.1.1",
    "expo-haptics": "~15.0.8",
    "globals": "16.5.0",
    "jest": "^29.7.0",
    "jest-expo": "^54.0.13",
    "jsdom": "26.1.0",
    "marked": "^15.0.12",
    "node": "24.22.1",
    "node-web-audio-api": "^2.2.0",
    "pngjs": "3.4.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "2.28.0",
    "react-native-reanimated": "4.1.1",
    "react-native-worklets": "0.5.1",
    "react-test-renderer": "19.3.1",
    "sharp": "^0.35.5",
    "tsrs": "0.18.0-ts7.1.0-dev.20260929",
    "turbo": "2.11.10",
    "typescript": "6.0.3",
    "typescript-7": "npm:typescript@7.0.2",
    "typescript-eslint": "8.72.0",
    "vaul": "1.1.2",
    "vite": "6.4.5",
    "vitest": "4.1.12"
  },
  "overrides": {
    "postcss": "8.5.30"
  }
}
