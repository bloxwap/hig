{
  "name": "bloxwap-hig-workspace",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "fixtures/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.22"
  },
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "build": "npm run generate && node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && node scripts/check-drift.mjs",
    "test": "npm run test:web && npm run test:native",
    "check": "npm run build && npm run lint && npm run typecheck && npm test",
    "dev": "vite fixtures/web --host 0.0.0.0",
    "smoke:ssr": "node fixtures/ssr/smoke.mjs",
    "smoke:packed": "node scripts/packed-smoke.mjs",
    "test:web": "vitest run",
    "test:native": "jest --config jest.native.config.cjs",
    "smoke:packed-native": "node scripts/packed-native-smoke.mjs",
    "generate:cues": "node scripts/export-cues.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@bloxwap/chart": "0.3.0",
    "@bloxwap/font": "0.1.2",
    "@bloxwap/haptic": "^0.1.0",
    "@bloxwap/sfx": "^0.1.0",
    "@eslint/js": "9.39.1",
    "@playwright/test": "^1.56.1",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "22.18.10",
    "@types/react": "19.1.16",
    "@types/react-dom": "19.1.9",
    "@types/react-test-renderer": "19.1.0",
    "eslint": "9.39.1",
    "expo-audio": "~1.1.1",
    "expo-haptics": "~15.0.7",
    "globals": "16.4.0",
    "jest": "^29.7.0",
    "jest-expo": "^54.0.13",
    "jsdom": "26.1.0",
    "node": "22.22.0",
    "node-web-audio-api": "^2.2.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-test-renderer": "19.1.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.1",
    "vite": "6.4.1",
    "vitest": "3.2.4"
  }
}
