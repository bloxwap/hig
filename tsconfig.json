{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "esModuleInterop": true
  },
  "include": [
    "packages/*/src",
    "fixtures/*/*.tsx",
    "fixtures/*/src",
    "apps/*/src",
    "tests",
    "types",
    "fixtures/native/*.ts"
  ]
}
